{
  "name": "luma-valley",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-localization": "~58.0.5",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 19006",
    "start:go": "expo start --go",
    "start:go:tunnel": "expo start --go --tunnel",
    "test": "node --no-warnings --import ./scripts/ts-register.mjs --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sprites": "node --no-warnings --import ./scripts/ts-register.mjs scripts/gen-sprites.ts",
    "preview-art": "node --no-warnings --import ./scripts/ts-register.mjs scripts/gen-sprites.ts --preview art-preview",
    "sfx": "node scripts/gen-sfx.mjs",
    "balance": "node --no-warnings --import ./scripts/ts-register.mjs scripts/balance-gates.ts",
    "simulate": "node --no-warnings --import ./scripts/ts-register.mjs scripts/simulate.ts",
    "postinstall": "setup-skia-web public",
    "e2e": "node scripts/e2e-web.mjs e2e-out",
    "brand": "node --no-warnings --import ./scripts/ts-register.mjs scripts/gen-brand.ts",
    "lint": "expo lint"
  },
  "private": true
}
